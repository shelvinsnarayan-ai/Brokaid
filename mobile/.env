# Placeholder — this project has no mobile surface.
#
# brokAId is a web-only monorepo (frontend + backend). Emergent's
# native deploy pipeline reads env files from a fixed set of paths
# (frontend/.env, backend/.env, mobile/.env). This file exists solely
# to satisfy that reader so the BUILD step can hydrate without a
# `no such file or directory` error. No mobile app, no code, no
# secrets belong here.
EXPO_PACKAGER_PROXY_URL=https://brokaid-demo.expo.preview.emergentagent.com
